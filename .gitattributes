# Text is LF everywhere, including generated course files, so a rebuild on
# Windows produces the same bytes and no git diff.
* text=auto eol=lf

# Windows batch files must stay CRLF to run reliably.
*.bat text eol=crlf

# Binary artifacts: never touch their bytes.
*.zip binary
*.ico binary
*.wasm binary
*.whl binary

# Vendored Pyodide runtime: keep exactly as shipped.
dist/python/** -text
